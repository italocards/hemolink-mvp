rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Usuários ─────────────────────────────────────────────────────────────
    match /users/{userId} {

      // Qualquer usuário autenticado pode LISTAR a coleção (necessário para o ranking)
      allow list: if request.auth != null;

      // Apenas o próprio dono pode LER o documento individual
      allow get: if request.auth != null && request.auth.uid == userId;

      // Apenas o próprio dono pode CRIAR seu documento (cadastro)
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasAll(['id', 'nome', 'email', 'tipoSanguineo'])
                    && request.resource.data.id == userId
                    && request.resource.data.tipoSanguineo in ['A+','A-','B+','B-','AB+','AB-','O+','O-'];

      // Apenas o próprio dono pode ATUALIZAR seu documento
      // (perfil, localização, pontos, titulo, flags de bônus)
      allow update: if request.auth != null && request.auth.uid == userId;

      allow delete: if false;
    }

    // ── Hemocentros ──────────────────────────────────────────────────────────
    // Leitura para qualquer usuário autenticado
    // Escrita apenas pelo próprio hemocentro (ownerId == auth.uid)
    match /hemocentros/{hemocentroId} {
      allow read, list: if request.auth != null;
      
      // Hemocentro pode atualizar seus próprios dados (perfil)
      allow update: if request.auth != null 
                    && resource.data.ownerId == request.auth.uid;
      
      // Criação e deleção bloqueadas (via console/seed apenas)
      allow create, delete: if false;
    }

    // ── Solicitações ─────────────────────────────────────────────────────────
    // Leitura para qualquer usuário autenticado
    // Hemocentros podem criar e atualizar suas próprias solicitações
    match /solicitacoes/{solicitacaoId} {
      allow read: if request.auth != null;
      
      // Hemocentro pode criar solicitação para si mesmo
      allow create: if request.auth != null
                    && request.resource.data.hemocentroId == request.auth.uid;
      
      // Hemocentro pode atualizar suas próprias solicitações (ex: encerrar)
      allow update: if request.auth != null
                    && resource.data.hemocentroId == request.auth.uid;
      
      allow delete: if false;
      
      // ── Candidatos (subcoleção de solicitações) ──────────────────────────
      // Sistema de classificação e ranking de doadores
      match /candidatos/{candidatoId} {
        // Qualquer usuário autenticado pode ler candidatos
        allow read, list: if request.auth != null;
        
        // Sistema pode criar/atualizar (via backend/cloud functions)
        // Por enquanto, permitir escrita autenticada para o mock
        allow write: if request.auth != null;
      }
    }

    // ── Respostas ─────────────────────────────────────────────────────────────
    // Criação apenas pelo próprio doador
    // Leitura pelo doador OU pelo hemocentro dono da solicitação
    match /respostas/{respostaId} {
      allow create: if request.auth != null
                    && request.resource.data.doadorId == request.auth.uid
                    && request.resource.data.keys().hasAll(['solicitacaoId', 'doadorId', 'resposta', 'data'])
                    && request.resource.data.resposta in ['aceita', 'recusada'];

      // Doador pode ler suas próprias respostas
      allow read: if request.auth != null
                  && resource.data.doadorId == request.auth.uid;

      // Hemocentro pode listar respostas das suas solicitações (painel de candidatos)
      allow list: if request.auth != null;

      allow update, delete: if false;
    }
  }
}
